universe = vanilla

executable = run_makeLFVHistos_onefile.sh

arguments = $(inputfile) $(jobid) $(outputdir) $(channel) $(pmax) $(mmax)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_input_files = \
    makeLFVHistos_selection.py, \
    reconstructZMass.py

transfer_output_files = ""

output = condor_logs/job_$(jobid).out
error  = condor_logs/job_$(jobid).err
log    = condor_logs/job_$(jobid).log

+JobFlavour = "longlunch"

queue inputfile,jobid,outputdir,channel,pmax,mmax from joblist.txt
